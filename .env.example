# Configuration MongoDB Atlas
# Pour utiliser MongoDB local (développement), utilisez : mongodb://localhost:27017
# Pour MongoDB Atlas (production), remplacez par votre URI de connexion

# URI de connexion MongoDB (local ou Atlas)
MONGODB_URI=mongodb://localhost:27017

# Nom de la base de données
MONGODB_DATABASE=LabelisationDB

# Configuration du serveur
PORT=3000
HOST=0.0.0.0
